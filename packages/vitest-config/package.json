{
  "name": "@repo/vitest-config",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/configs/base-config.ts",
    "./ui": "./src/configs/ui-config.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "collect-json-reports": "npx tsx src/scripts/collect-json-outputs.ts",
    "merge-json-reports": "nyc merge coverage/raw coverage/merged/merged-coverage.json",
    "report": "nyc report -t coverage/merged --report-dir coverage/report --reporter=html --exclude-after-remap false",
    "view-report": "open coverage/report/index.html"
  },
  "dependencies": {
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^25.0.1",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "glob": "^13.0.6",
    "nyc": "^18.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
