{
  "name": "@repo/vitest-config",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/configs/base-config.ts",
    "./ui": "./src/configs/ui-config.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "collect-json-reports": "tsx src/scripts/collect-json-outputs.ts",
    "merge-json-reports": "node src/scripts/coverage-report.mjs merge",
    "report": "node src/scripts/coverage-report.mjs report",
    "view-report": "open coverage/report/index.html"
  },
  "dependencies": {
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^25.0.1",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "glob": "^13.0.6",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
