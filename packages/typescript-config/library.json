  "extends": "./base.json",
  "compilerOptions": {
    "baseUrl": "src",
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "types": ["node"],
    "paths": {
