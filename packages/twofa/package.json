{
  "name": "@repo/twofa",
  "version": "1.0.0",
  "description": "TOTP (Time-based One-Time Password) implementation for client and server",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    }
  },
  "keywords": ["totp", "2fa", "authentication"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@repo/typescript-config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "0.19.0",
    "typescript": "catalog:"
  }
}
