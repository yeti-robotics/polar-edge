DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polar_edge

DISCORD_CLIENT_ID= # application id in discord developer portal
DISCORD_CLIENT_SECRET= # oauth secret in discord developer portal
DISCORD_BOT_TOKEN= # optional: bot token used to resolve server nicknames on leaderboards
DISCORD_GUILD_ID= # optional: server id used with DISCORD_BOT_TOKEN for leaderboard names

BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails; super admins can create orgs and sign up without an invite
ADMIN_EMAILS=

# DigitalOcean Spaces (S3-compatible storage for robot photos)
SPACES_ENDPOINT=    # e.g. https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=      # bucket name
SPACES_KEY=         # DO Spaces access key
SPACES_SECRET=      # DO Spaces secret key
