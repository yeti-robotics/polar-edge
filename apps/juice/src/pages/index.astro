---
import "../styles/globals.css";
import { HomeTabs } from "../components/HomeTabs";
---

<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Juice — FRC Battery Tools</title>
	</head>
	<body class="min-h-screen bg-background text-foreground">
		<div class="sticky top-0 z-50 flex items-center gap-4 border-b border-border bg-background/95 px-5 py-2.5 backdrop-blur-sm">
			<a href="/" class="shrink-0 font-mono text-sm font-bold uppercase tracking-widest text-primary">
				JUICE
			</a>
			<nav class="flex gap-0 overflow-x-auto">
				<a href="/" class="whitespace-nowrap border-b-2 border-primary px-4 py-2.5 font-mono text-[10px] uppercase tracking-wider text-primary">Home</a>
				<a href="/analyzer" class="whitespace-nowrap border-b-2 border-transparent px-4 py-2.5 font-mono text-[10px] uppercase tracking-wider text-muted-foreground transition-colors hover:text-foreground">Analyzer</a>
				<a href="/tracker" class="whitespace-nowrap border-b-2 border-transparent px-4 py-2.5 font-mono text-[10px] uppercase tracking-wider text-muted-foreground transition-colors hover:text-foreground">Tracker</a>
			</nav>
		</div>
		<div class="flex min-h-[calc(100vh-3.5rem)] flex-col items-center justify-center px-6 py-12">
			<h1 class="mb-3 text-center text-3xl font-medium tracking-tight text-foreground">
				FRC Battery Tools
			</h1>
			<p class="mb-8 max-w-md text-center text-sm leading-relaxed text-muted-foreground">
				Analyze DS logs for voltage, current, and impedance — or track your battery fleet at competitions.
			</p>

			<HomeTabs client:load>
				<div class="grid w-full max-w-[520px] grid-cols-1 gap-4 sm:grid-cols-2">
					<a
						href="/analyzer"
						class="group rounded-lg border border-border bg-card p-6 transition-colors hover:border-primary/40"
					>
						<div class="mb-3 text-3xl">📊</div>
						<h2 class="mb-1 font-mono text-sm font-semibold uppercase tracking-wider text-foreground">
							Analyzer
						</h2>
						<p class="text-xs leading-relaxed text-muted-foreground">
							Upload DS logs and CAN data to analyze voltage trends, current demand, power, and battery impedance.
						</p>
						<span class="mt-3 inline-block font-mono text-xs text-primary opacity-0 transition-opacity group-hover:opacity-100">
							Open →
						</span>
					</a>

					<a
						href="/tracker"
						class="group rounded-lg border border-border bg-card p-6 transition-colors hover:border-primary/40"
					>
						<div class="mb-3 text-3xl">🔋</div>
						<h2 class="mb-1 font-mono text-sm font-semibold uppercase tracking-wider text-foreground">
							Battery Tracker
						</h2>
						<p class="text-xs leading-relaxed text-muted-foreground">
							Track battery check-outs, KW700 readings, voltage, brownouts, and performance at events.
						</p>
						<span class="mt-3 inline-block font-mono text-xs text-primary opacity-0 transition-opacity group-hover:opacity-100">
							Open →
						</span>
					</a>
				</div>
			</HomeTabs>
		</div>
	</body>
</html>
